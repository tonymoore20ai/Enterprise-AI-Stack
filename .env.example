# Every variable the stack needs. Real values live in .env (mode 600, never committed).
# Don't fill this in by hand - generate them, in this order (see SETUP.md):
#   python3 setup/init_env.py     base secrets below + seaweedfs/s3.json
#   python3 litellm/add_env.py    LiteLLM + vLLM keys
#   python3 datastores/add_env.py Redis + Qdrant credentials
#   python3 ide/setup.py          IDE user + password hash

# --- Base secrets (setup/init_env.py) -------------------------------------
LANGFUSE_DB_PASSWORD=           # Langfuse Postgres
LANGFUSE_CLICKHOUSE_PASSWORD=   # Langfuse ClickHouse
OTEL_CLICKHOUSE_PASSWORD=       # ClickHouse for OTel spans (also used by Grafana + collector)
LANGFUSE_NEXTAUTH_SECRET=       # Langfuse session signing
LANGFUSE_SALT=                  # Langfuse API key hashing - never change after first start
LANGFUSE_ENCRYPTION_KEY=        # 64 hex chars - never change after first start
LANGFUSE_INIT_USER_PASSWORD=    # first Langfuse login (tony@enterprise.local)
GRAFANA_ADMIN_PASSWORD=         # Grafana 'admin' login
S3_ACCESS_KEY=                  # SeaweedFS S3 (must match seaweedfs/s3.json)
S3_SECRET_KEY=

# --- LLM gateway (litellm/add_env.py) -------------------------------------
LITELLM_MASTER_KEY=             # LiteLLM admin key - never give to a client
LITELLM_SALT_KEY=               # encrypts stored credentials - never change once keys exist
LITELLM_DB_PASSWORD=            # LiteLLM Postgres
VLLM_API_KEY=                   # only LiteLLM knows this; vLLM rejects everything else

# --- Data stores (datastores/add_env.py) ----------------------------------
REDIS_PASSWORD=                 # Redis (agent memory + Langfuse queue)
QDRANT_API_KEY=                 # Qdrant (knowledge base)

# --- IDE (ide/setup.py) ----------------------------------------------------
HOST_UID=                       # your user ID, so IDE-created files are yours
HOST_GID=
CODE_SERVER_HASHED_PASSWORD=    # argon2 hash of the IDE password

# Application secrets (Langfuse API keys, LiteLLM virtual keys, chat API keys)
# are NOT here: they live in Vault under secret/agent/*.
